# ============================================================================
# CONFIGURAÇÃO DO SERVIDOR DE COMPARTILHAMENTO DE TELA (SFU 1080p60)
# Copie este arquivo para .env e personalize os valores
# ============================================================================

# Nome que aparece no topo da sala
SERVER_NAME="STAGE // 1080p60"

# Senha única para os amigos entrarem na sala (MUDE ESTA SENHA!)
ROOM_PASSWORD="troque-esta-senha-123"

# Segredo para assinar os tokens de sessão (pode ser qualquer frase longa)
SESSION_SECRET="chave-secreta-local-muito-segura-2026"

# Portas do Servidor Node.js
PORT=3000
HTTPS_PORT=3443

# ============================================================================
# REDE WEBRTC (HÍBRIDA: LOCAL / VPN / DUCKDNS / TÚNEL)
# ============================================================================
# Se deixar vazio, o servidor detecta automaticamente o IP/Host pelo qual
# cada amigo conectou (funciona automático em localhost, LAN e Tailscale/Radmin).
# Se for usar Port Forwarding no roteador ou DuckDNS, coloque seu IP Público ou domínio:
ANNOUNCED_IP=""

# Faixa de portas UDP/TCP usadas pelo Mediasoup para vídeo/áudio em alta velocidade
RTC_MIN_PORT=40000
RTC_MAX_PORT=40050

# Domínio para o Caddy gerar HTTPS (ex: meuservidor.duckdns.org ou localhost)
CADDY_DOMAIN="localhost"
